{
  "name": "scima",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~56.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~56.0.9",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.17",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.10",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-print": "~56.0.3",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ai-proxy": "node --env-file=.env scripts/ai-proxy.mjs",
    "lint": "expo lint",
    "bundle:eval": "esbuild src/services/ai/openaiClient.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/companion-bundle.mjs && esbuild src/services/ai/safety.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/safety-bundle.mjs && esbuild src/services/ai/engine.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=scripts/engine-bundle.mjs",
    "test:safety": "npm run bundle:eval --silent && node scripts/safety-regression.mjs",
    "test:engine": "npm run bundle:eval --silent && node scripts/engine-regression.mjs",
    "test:all": "npm run bundle:eval --silent && node scripts/safety-regression.mjs && node scripts/engine-regression.mjs && node scripts/memory-regression.mjs && node scripts/progression-regression.mjs",
    "test:memory": "npm run bundle:eval --silent && node scripts/memory-regression.mjs",
    "test:progression": "npm run bundle:eval --silent && node scripts/progression-regression.mjs"
  },
  "private": true
}
