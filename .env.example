# Copy to `.env` (gitignored) and fill in. The companion works without any of
# these (it falls back to the on-device engine); set them to use OpenAI.

# Read ONLY by the local dev proxy (scripts/ai-proxy.mjs) — never bundled.
OPENAI_API_KEY=

# Optional model override (default: gpt-4o-mini).
EXPO_PUBLIC_OPENAI_MODEL=gpt-5.4-mini

# If set, the app calls this proxy instead of OpenAI directly. Required for the
# web preview (browsers can't call OpenAI — CORS) and works for native too.
# Run the proxy with: npm run ai-proxy
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:8787/chat
